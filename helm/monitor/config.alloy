local.file_match "podlogs" {
  path_targets = [
    { __path__ = "/var/log/pods/msa*/*/*.log" },
    { __path__ = "/var/log/pods/traefik*/*/*.log" },
  ]
}

loki.source.file "filelog" {
  targets    = local.file_match.podlogs.targets
  forward_to = [ loki.process.parse_and_label.receiver ]
}

loki.process "parse_and_label" {

  stage.cri {}


  stage.label_drop { values = ["filename", "stream"] }


  stage.json {
    source = "content"
    expressions = {
      level        = "level",
      timestamp    = "timestamp",
      hostname     = "hostname",
      trace_id     = "trace_id",
      span_id      = "span_id",
      time         = "time",
      reqId        = "reqId",
      trace_flags  = "trace_flags",
      res          = "res",
      responseTime = "responseTime",
      msg          = "msg",
    }
    drop_malformed = false
  }

  stage.output { source = "content" }

  stage.labels {
    values = {
      level    = "level",
      hostname = "hostname",
    }
  }

  forward_to = [ loki.write.loki.receiver ]
}

loki.write "loki" {
  endpoint {
    url     = "http://loki-gateway.monitor.svc.cluster.local/loki/api/v1/push"
    headers = { "X-Scope-OrgID" = "pingpong1" }
  }
}
