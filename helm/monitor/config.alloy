local.file_match "podlogs" {
  path_targets = [
    { __path__ = "/var/log/pods/msa*/*/*.log" },
  ]
}

loki.source.file "filelog" {
  targets    = local.file_match.podlogs.targets
  forward_to = [ loki.process.parse_and_label.receiver ]
}

loki.process "parse_and_label" {
  stage.json {
    expressions = {
      raw = "log",
    }
    drop_malformed = false
  }

  stage.json {
    source      = "raw"
    expressions = {
      level         = "level",
      timestamp     = "timestamp",
      hostname      = "hostname",
      trace_id      = "trace_id",
      span_id       = "span_id",
      time          = "time",
      reqId         = "reqId",
      trace_flags    = "trace_flags",
      res            = "res",
      responseTime  = "responseTime",
      msg           = "msg",
    }
    drop_malformed = false
  }

  stage.output {
    source = "raw"
  }

  stage.labels {
    values = {
      pod      = "${resource.attributes.k8s.pod.name}",
      level     = "level",
      hostname  = "hostname",
      trace_id  = "trace_id",
      span_id   = "span_id",
    }
  }

  forward_to = [
    loki.write.loki.receiver,
  ]
}



loki.write "loki" {
  endpoint {
    url     = "http://loki-gateway.monitor.svc.cluster.local/loki/api/v1/push"
    headers = { "X-Scope-OrgID" = "pingpong" }
  }
}
